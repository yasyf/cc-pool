# Build artifacts (anchored to repo root so cmd/cc-pool/ is NOT ignored)
/build/
/cc-pool
/ccp

# Go workspace (machine-local; never committed)
/go.work
/go.work.sum

# Local state that should never be committed
*.db
*.db-wal
*.db-shm
*.sock
*.log

# Go
/vendor/

# Swift widget (regenerated by `xcodegen generate`)
/widget/*.xcodeproj
/widget/Generated/
/widget/Version.xcconfig
/widget/build/
/widget/build-*/
