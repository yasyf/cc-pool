# Homebrew formula for cc-pool. Installs the prebuilt universal binary from
# GitHub Releases — no Go toolchain needed.
#
#   brew install yasyf/tap/cc-pool
#
# One prebuilt pure-Go universal binary (arm64 + amd64) ships per release.
#
# This file is GENERATED by cc-pool's release.yml (render-formula) and
# pushed here on every tagged release — do not hand-edit; change the
# template at .github/formula/cc-pool.rb.tmpl in cc-pool instead.
class CcPool < Formula
  desc "Predictive multi-account load-balancing for Claude Code"
  homepage "https://github.com/yasyf/cc-pool"
  url "https://github.com/yasyf/cc-pool/releases/download/v__VERSION__/cc-pool-v__VERSION__-darwin-universal.tar.gz"
  sha256 "__SHA_PURE__" # pure
  license "PolyForm-Noncommercial-1.0.0"

  livecheck do
    url :stable
    strategy :github_latest
  end

  depends_on :macos

  resource "status_app" do
    url "https://github.com/yasyf/cc-pool/releases/download/v__VERSION__/cc-pool-status-v__VERSION__-darwin.zip"
    sha256 "__SHA_APP__"
  end

  def install
    bin.install "cc-pool"
    resource("status_app").stage do
      system "/usr/bin/codesign", "--verify", "--deep", "--strict", "--verbose=2", "CCPoolStatus.app"
      system "/usr/bin/xcrun", "stapler", "validate", "CCPoolStatus.app"
      system "/usr/sbin/spctl", "--assess", "--type", "execute", "--verbose=4", "CCPoolStatus.app"
      app_version = Utils.safe_popen_read(
        "/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString",
        "CCPoolStatus.app/Contents/Info.plist"
      ).strip
      odie "CCPoolStatus.app version #{app_version} does not match #{version}" if app_version != version.to_s
      libexec.install "CCPoolStatus.app"
    end
    bin.install_symlink "cc-pool" => "ccp"
  end

  def caveats
    <<~EOS
      Get started:
        ccp package install # install and activate this release's signed application
        ccp service install # install and start the account daemon
        ccp             # walks you through pooling your subscriptions
        ccp run         # launch claude on the emptiest account

      `ccp package install` verifies the formula's exact signed application,
      installs it outside Homebrew's sandbox into:
        ~/Applications/CCPoolStatus.app

      daemonkit owns the user LaunchAgent. Homebrew does not install or control
      a second daemon service.

      Plain `claude` on ~/.claude keeps working untouched.

      Before `brew uninstall`, run `ccp service uninstall` and then
      `ccp package uninstall`.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/cc-pool --version")
    assert_match "emptiest account", shell_output("#{bin}/ccp --help")
  end
end
